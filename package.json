{
  "name": "@iamzayn19/depcanary",
  "version": "0.1.0",
  "description": "See risky dependency updates before they land. DepCanary compares two published npm package versions and shows newly introduced risky behavior.",
  "keywords": [
    "npm",
    "security",
    "supply-chain",
    "dependency",
    "diff",
    "audit",
    "cli",
    "devsecops"
  ],
  "homepage": "https://github.com/iamzayn19/depcanary#readme",
  "bugs": {
    "url": "https://github.com/iamzayn19/depcanary/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iamzayn19/depcanary.git"
  },
  "license": "MIT",
  "type": "module",
  "bin": {
    "depcanary": "./dist/cli/main.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist coverage",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run test/unit test/integration test/cli test/security",
    "test:unit": "vitest run test/unit",
    "test:integration": "vitest run test/integration",
    "test:cli": "vitest run test/cli",
    "test:coverage": "vitest run test/unit test/integration test/cli test/security --coverage",
    "test:live": "node --experimental-vm-modules scripts/live-smoke.mjs",
    "smoke": "node scripts/smoke-test.mjs",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build",
    "prepack": "npm run check"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@typescript-eslint/eslint-plugin": "^8.18.1",
    "@typescript-eslint/parser": "^8.18.1",
    "@vitest/coverage-v8": "^2.1.8",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "@babel/parser": "^7.26.2",
    "@babel/types": "^7.26.3",
    "commander": "^12.1.0",
    "picocolors": "^1.1.1",
    "tar": "^7.4.3"
  }
}
